{
  "name": "sonia_beauty",
  "version": "1.0.0",
  "description": "Website affiliate aesthetic dan clean dengan dashboard admin yang terintegrasi dengan Neon Database, Better Auth, dan Vercel Blob.",
  "main": "index.js",
  "scripts": {
    "dev": "vite --port 3000 --host localhost",
    "serve": "vite --port 3000 --host localhost",
    "build": "npm run build:client && vite build",
    "build:client": "esbuild src/index.ts --bundle --format=iife --global-name=NeonBundle --outfile=dist/neon.browser.js --platform=browser --define:process.env.NODE_ENV=\\\"production\\\" && node -e \"import('fs').then(fs => { fs.copyFileSync('dist/neon.browser.js', 'public/dist/neon.browser.js'); fs.copyFileSync('dist/neon.browser.js', 'public/neon.browser.js'); })\"",
    "typecheck": "tsc --noEmit",
    "export:users": "node export_supabase_users.ts",
    "import:users": "node import_neon_users.ts",
    "migrate:storage": "node migrate_storage_to_blob.ts",
    "test:realtime": "node test_realtime.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "monitor": "node monitor.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soniaevangelyn-arch/soniastore.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/soniaevangelyn-arch/soniastore/issues"
  },
  "homepage": "https://github.com/soniaevangelyn-arch/soniastore#readme",
  "dependencies": {
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.0-beta",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
